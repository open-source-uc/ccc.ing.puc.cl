---
import BaseLayout from "~/layouts/Base.astro";
import Iniciativas from "./Iniciativas.svelte";
---

<BaseLayout
	title="Iniciativas"
	bannerImage="/og/specific/iniciativas.png"
	description="Iniciativas y clubes relacionados al DCC"
>
	<div class="mx-auto w-full max-w-4xl px-4 py-6">
		<h2 class="font-title text-xl">Iniciativas relacionadas al DCC</h2>
		<p>
			Iniciativas y clubes relacionados al DCC.
			<a href="/grupos" class="underline">Los grupos generales están en este link</a>.
		</p>
	</div>
	<div class="flex-grow bg-stone-200 shadow-inner">
		<Iniciativas client:idle />
	</div>
</BaseLayout>

<style>
	ul {
		display: flex;
		flex-direction: column;
	}
	@media screen(md) {
		ul {
			display: grid;
			grid-auto-rows: 1fr;
			grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
		}
	}
</style>
